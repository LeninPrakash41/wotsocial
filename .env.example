# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Public base URL of this app. Used for OAuth redirect URIs and the webhook
# callback URL, so it must match what you register in the Meta app dashboard.
APP_URL="http://localhost:3050"

PORT=3050

# ---------------------------------------------------------------------------
# Token vault (REQUIRED in production)
# ---------------------------------------------------------------------------
# Platform access tokens are encrypted at rest with AES-256-GCM using this key.
# Generate one with:  openssl rand -hex 32
# In local dev a key is auto-generated at .wotsocial-encryption-key.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Logging and limits
# ---------------------------------------------------------------------------
# debug | info | warn | error. Defaults to debug outside production.
LOG_LEVEL=
# json for aggregators, pretty for humans. Defaults to pretty outside production.
LOG_FORMAT=

# Requests permitted per window, per instance. These are enforced in-process,
# so behind several instances each enforces its own share — useful as a
# backstop, not a substitute for a limiter at the edge.
RATE_LIMIT_API=300
RATE_LIMIT_LOGIN=30
RATE_LIMIT_COSTLY=30
RATE_LIMIT_UPLOAD=60

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# Generated images and video have to live somewhere the social platforms can
# fetch them — Instagram, the Meta Marketing API and WhatsApp all pull media by
# URL from their own servers.
#
# Leave S3_BUCKET blank and media is written to ./.media and served by this
# app, which is fine for development but unreachable by the platforms unless
# the app itself is public.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# For Cloudflare R2, MinIO or any other S3-compatible store.
S3_ENDPOINT=
# The CDN or bucket origin assets are served from, if not the default.
S3_PUBLIC_BASE_URL=
# Set to false if the bucket serves public reads by policy rather than per-object ACL.
S3_PUBLIC_ACL=

# Upload ceiling. The platforms enforce their own, lower limits at publish time.
MEDIA_MAX_BYTES=104857600
MEDIA_LOCAL_DIR=.media

# ---------------------------------------------------------------------------
# Administrator account
# ---------------------------------------------------------------------------
# Created once, on an empty database. Leave ADMIN_PASSWORD blank and one is
# generated, printed to the server log at first boot, and must be changed at
# first sign-in. Set it to choose your own instead.
ADMIN_EMAIL=admin@wotsocial.com
ADMIN_PASSWORD=
ADMIN_NAME=

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# How long a sign-in lasts before the token expires.
SESSION_TTL_HOURS=336

# Failed sign-ins tolerated per email before the account is briefly locked.
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Meta (Facebook / Instagram / WhatsApp) — one app covers all three
# ---------------------------------------------------------------------------
# From developers.facebook.com → your app → Settings → Basic.
# Without these, OAuth and webhook signature verification are both disabled and
# accounts can only be connected with manually generated access tokens.
META_APP_ID=
META_APP_SECRET=

# Any random string you choose. Enter the same value in the Meta app dashboard
# under Webhooks → Verify Token. Required for Instagram DM automation,
# WhatsApp delivery receipts, and Meta lead-form capture.
META_WEBHOOK_VERIFY_TOKEN=

# Optional overrides
META_GRAPH_VERSION=v21.0
META_HTTP_TIMEOUT_MS=30000
META_MAX_RETRIES=4
WHATSAPP_SEND_INTERVAL_MS=60

# ---------------------------------------------------------------------------
# Google Ads
# ---------------------------------------------------------------------------
# The developer token comes from your Google Ads manager account and must be
# approved by Google before it works against live accounts — a test-account
# token only reaches test accounts.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v18

# One OAuth client covers Google Ads and YouTube. Needs the adwords scope for
# ads and youtube.upload for video.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# TikTok
# ---------------------------------------------------------------------------
# From the TikTok developer portal. Direct posting needs the app to be
# approved; without it, videos go to the creator's inbox as a draft, and the
# domain serving the video must be verified in the portal either way.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Database (optional — SQLite is used automatically when unset)
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Other social platforms (used by the scheduler cron)
# ---------------------------------------------------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_API_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
FACEBOOK_ACCESS_TOKEN=

# Vercel cron authentication
CRON_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Gemini and Claude keys are entered per-user in the Integrations page and
# stored in the browser. This one is only used by server-side jobs.
GEMINI_API_KEY=
